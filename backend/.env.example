INQUISPACE_ENVIRONMENT=development
# 默认 backend/data；自定义时建议使用绝对路径。
# INQUISPACE_DATA_DIR=/absolute/path/to/data

# 构建 frontend 后才启用；开发时使用 Vite 的 /api 代理。
INQUISPACE_SERVE_FRONTEND=false
# INQUISPACE_FRONTEND_DIST=/absolute/path/to/frontend/dist

# P3 使用 DeepSeek Chat Completions API；密钥仅配置在后端，不要使用 VITE_ 前缀。
# INQUISPACE_LLM_API_KEY=
INQUISPACE_LLM_BASE_URL=https://api.deepseek.com
INQUISPACE_LLM_MODEL=deepseek-flash
# DeepSeek 支持 low/high/max；默认 high。
INQUISPACE_LLM_EFFORT=high
INQUISPACE_LLM_MAX_OUTPUT_TOKENS=16000

# P0 集中工程默认值；后续业务接入后才执行资料/模型/课堂限制。
INQUISPACE_MAX_SOURCES_PER_VERSION=10
INQUISPACE_MAX_UPLOAD_BYTES=10485760
INQUISPACE_MAX_PDF_PAGES=100
INQUISPACE_MODEL_TIMEOUT_SECONDS=60
INQUISPACE_PARSE_TIMEOUT_SECONDS=60
INQUISPACE_RUN_TIMEOUT_SECONDS=180
INQUISPACE_RUN_MAX_STEPS=20
INQUISPACE_CONFIRMATION_TTL_SECONDS=1800
INQUISPACE_MODEL_MAX_CONCURRENCY=2
INQUISPACE_SQLITE_BUSY_TIMEOUT_MS=5000

# 可调整的课堂初值，不代表已确定教学要求，不提供/猜测历史时间锚点。
INQUISPACE_DEFAULT_SUBJECT=历史
INQUISPACE_DEFAULT_GRADE=高中
INQUISPACE_DEFAULT_DURATION_MINUTES=45
INQUISPACE_DEFAULT_MAX_TURNS=20

# 迁移后显式执行：backend/.venv/bin/python -m app.seed
# 固定账号 teacher、student1、student2；已存在的账号完全不修改。
# 默认通过终端无回显输入并确认密码。自动化可由密钥管理器注入以下进程环境变量：
# INQUISPACE_SEED_TEACHER_PASSWORD / INQUISPACE_SEED_STUDENT1_PASSWORD /
# INQUISPACE_SEED_STUDENT2_PASSWORD。种子不从 .env 文件读取密码。
# 不要把密码写到此文件、命令行参数或 shell 历史；应用启动不自动创建账号。
